@inherits LocalizedComponentBase
@inject IJSRuntime JS

@if (showBanner)
{
    <div class="kf-topbar">
        <div class="kf-topbar-inner">
            <div class="kf-topbar-copy">
                <span class="kf-topbar-dot"></span>
                <span class="kf-topbar-message">@Lang.T("banner.text")</span>
                <a href="@BannerCtaHref" class="kf-topbar-link">@Lang.T("banner.cta")</a>
            </div>
            <button class="kf-topbar-close" type="button" @onclick="CloseBanner" aria-label="@Lang.T("nav.closeMessage")">×</button>
        </div>
    </div>
}

<nav class="kf-nav kf-minimal-nav @(showBanner ? "with-topbar" : "") @(navOpen ? "menu-open" : "")" @onkeydown="HandleMenuKey">
    <div class="kf-nav-inner">
        <a href="/" class="kf-minimal-brand">By Krydsfelt</a>

        <div class="kf-nav-center">
            <div class="kf-nav-links">
                <a href="/" class="@GetLinkClass("home")">@Lang.T("nav.home")</a>
                <a href="/om-os" class="@GetLinkClass("about")">@Lang.T("nav.about")</a>

                <a href="/ydelser" class="@GetLinkClass("services")">@Lang.T("nav.services")</a>
            </div>
        </div>

        <div class="kf-nav-utilities">
            <div class="kf-language-switch" role="group" aria-label="@Lang.T("nav.language")">
                @foreach (var language in LanguageOptions)
                {
                    <button type="button"
                            class="kf-language-choice @(Lang.CurrentLanguage == language.Code ? "is-active" : "")"
                            aria-label="@language.Label"
                            aria-pressed="@(Lang.CurrentLanguage == language.Code)"
                            @onclick="() => SelectLanguage(language.Code)">@language.ShortLabel</button>
                }
            </div>

            <button type="button" class="kf-nav-hamburger @(navOpen ? "open" : "")" @onclick="ToggleMenu" aria-label="Menu" aria-expanded="@navOpen" aria-controls="kf-nav-mobile">
                <span></span><span></span><span></span>
            </button>

            @if (!HideContactButton)
            {
                <a href="@ContactHref" class="kf-minimal-contact">@Lang.T("nav.bookMeeting")</a>
            }
        </div>
    </div>

    <div id="kf-nav-mobile" class="kf-nav-mobile @(navOpen ? "open" : "")">
        <a href="/" @onclick="CloseMenu">@Lang.T("nav.home")</a>
        <a href="/om-os" @onclick="CloseMenu">@Lang.T("nav.about")</a>
        <a href="/ydelser" @onclick="CloseMenu">@Lang.T("nav.services")</a>
        @if (!HideContactButton)
        {
            <a href="@ContactHref" class="kf-nav-mobile-contact" @onclick="CloseMenu">@Lang.T("nav.bookMeeting") <span aria-hidden="true">→</span></a>
        }
    </div>
</nav>

@code {
    private static readonly LanguageOption[] LanguageOptions =
    [
        new("en", "English", "EN"),
        new("da", "Dansk", "DK")
    ];

    [Parameter] public string CurrentPage { get; set; } = "";
    [Parameter] public string ContactHref { get; set; } = "/kontakt";
    [Parameter] public string BannerCtaHref { get; set; } = "/kontakt";
    [Parameter] public bool HideContactButton { get; set; }

    private bool navOpen;
    private bool showBanner = true;



    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Lang.InitializeAsync(JS);
    }

    private string GetLinkClass(string key) =>
        key == "contact"
            ? (CurrentPage == "contact" ? "kf-nav-active" : string.Empty)
            : CurrentPage == key ? "kf-nav-active" : string.Empty;

    private void ToggleMenu()
    {
        navOpen = !navOpen;
    }

    private void CloseMenu()
    {
        navOpen = false;
    }

    private void HandleMenuKey(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") CloseMenu();
    }

    private void CloseBanner() => showBanner = false;

    private async Task SelectLanguage(string code)
    {
        navOpen = false;
        await Lang.SetLanguageAsync(code, JS);
    }

    private sealed record LanguageOption(string Code, string Label, string ShortLabel);
}
