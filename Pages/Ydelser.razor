@page "/ydelser"
@inherits LocalizedComponentBase
@inject IJSRuntime JS

<SeoHead Title="Krydsfelt - Services"
         Description="Krydsfelt designer og bygger digitale løsninger, der gør komplekse behov enkle at bruge."
         Path="/ydelser" />
<SiteHeader CurrentPage="services" ContactHref="/kontakt" />

<main class="yd-onepage">
    <section class="yd-onepage-hero">
        <div class="kf-hero-ripples" aria-hidden="true"></div>
        <div class="yd-onepage-hero-copy">
            <h2>@Lang.T("yd.showcase.hero")</h2>
            <p>@Lang.T("yd.showcase.about")</p>
            <a class="yd-onepage-hero-link" href="/kontakt">@Lang.T("yd.showcase.start") <span aria-hidden="true">→</span></a>
        </div>
    </section>

    <section class="yd-onepage-services" aria-labelledby="yd-onepage-services-title">
        <div class="yd-onepage-services-intro">
            <p class="yd-onepage-kicker">@Lang.T("yd2.services.label")</p>
            <h2 id="yd-onepage-services-title">@Lang.T("yd2.services.headingPrefix") <span>@Lang.T("yd2.services.headingAccent")</span></h2>
        </div>
        <div class="yd-onepage-list">
            @foreach (var service in Services)
            {
                <details class="yd-onepage-item" open>
                    <summary><span>@Lang.T(service.TitleKey)</span><i aria-hidden="true">+</i></summary>
                    <div class="yd-onepage-item-body">
                        <p>@Lang.T(service.SummaryKey)</p>
                        <p class="yd-onepage-item-label">@Lang.T("yd.onepage.includes")</p>
                        <ul>
                            @foreach (var itemKey in service.ItemKeys)
                            {
                                <li>@Lang.T(itemKey)</li>
                            }
                        </ul>
                        <a href="/kontakt" class="yd-onepage-item-link">@Lang.T("yd.showcase.start") <span aria-hidden="true">→</span></a>
                    </div>
                </details>
            }
        </div>
    </section>
</main>

<section class="kh-home-cta yd-showcase-cta">
    <div class="kf-container kh-home-cta-inner kh-home-cta-inner--portrait">
        <div class="kh-home-cta-copy">
            <h2>@Lang.T("yd2.cta.heading")</h2>
            <a href="/kontakt" class="oo2-cta-link">@Lang.T("yd2.cta.link")</a>
        </div>
        <div class="kh-home-cta-portrait">
            <img src="Pictures/Gio.jpeg" alt="Giorgio Kevin Beshara" />
        </div>
    </div>
</section>
<SiteFooter />

@code {
    private static readonly ServiceSection[] Services =
    [
        new("yd2.card.webudvikling.title", "yd.onepage.web.summary", ["yd.onepage.web.i1", "yd.onepage.web.i2", "yd.onepage.web.i3", "yd.onepage.web.i4"]),
        new("yd2.card.branding.title", "yd.onepage.brand.summary", ["yd.onepage.brand.i1", "yd.onepage.brand.i2", "yd.onepage.brand.i3", "yd.onepage.brand.i4"]),
        new("yd2.card.custom.title", "yd.onepage.custom.summary", ["yd.onepage.custom.i1", "yd.onepage.custom.i2", "yd.onepage.custom.i3", "yd.onepage.custom.i4"])
    ];

    private sealed record ServiceSection(string TitleKey, string SummaryKey, string[] ItemKeys);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await JS.InvokeVoidAsync("initAnimations");
    }
}
