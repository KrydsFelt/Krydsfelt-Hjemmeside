@page "/ydelser"
@inherits LocalizedComponentBase
@inject IJSRuntime JS

<SeoHead Title="Hjemmesider, webdesign og branding | Krydsfelt"
         Description="Se Krydsfelts ydelser: hjemmesider, webdesign, redesign, webshops, visuel identitet og digital strategi for virksomheder i Aarhus og Aalborg."
         Path="/ydelser" />
<SiteHeader CurrentPage="services" ContactHref="/kontakt" />

<main class="kf-services-page">
    <section class="kf-services-intro kf-services-reference-intro">
        <div class="kf-page-width">
            <div class="kf-services-reference-title">
                <span>@Lang.T("yd2.page.headingPrefix")</span> <em>@Lang.T("yd2.page.headingAccent")</em>
            </div>
            <p>@Lang.T("yd2.page.cardsIntro")</p>
        </div>
    </section>

    <section class="kf-services-showcase kf-services-reference-grid">
        <div class="kf-page-width">
            <div class="kf-services-card-grid">
                @foreach (var service in Services)
                {
                    <article class="kf-service-card kf-service-card-reference @service.Style @(service.Style is "websites" or "redesign" or "ecommerce" or "identity" or "strategy" ? "has-image" : "")">
                        <div class="kf-service-card-visual kf-service-reference-visual" aria-hidden="true">
                            @if (service.Style is "websites" or "redesign" or "ecommerce" or "identity" or "strategy")
                            {
                                <img class="kf-service-card-image" src="@(service.Style switch { "websites" => "/Pictures/billede-10.png", "redesign" => "/Pictures/billede-7.png", "ecommerce" => "/Pictures/billede-4.png", "identity" => "/Pictures/billede-8.png", "strategy" => "/Pictures/billede-9.png", _ => "/Pictures/billede-2.png" })" alt="" />
                            }
                            else
                            {
                                <div class="kf-service-wireframe">
                                    <span class="kf-wireframe-topline"></span>
                                    <span class="kf-wireframe-heading"></span>
                                    <span class="kf-wireframe-line wireframe-line-one"></span>
                                    <span class="kf-wireframe-line wireframe-line-two"></span>
                                    <span class="kf-wireframe-shape"></span>
                                    <span class="kf-wireframe-detail"></span>
                                </div>
                            }
                        </div>
                        <div class="kf-service-card-copy kf-service-reference-copy">
                            <h2>@Lang.T(service.TitleKey)</h2>
                            <p>@Lang.T(service.DescriptionKey)</p>
                            <div class="kf-service-reference-tags" aria-label="Kompetencer">
                                @foreach (var tag in service.Tags)
                                {
                                    <span>@tag</span>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
        </div>
    </section>

    <section class="kh-home-cta">
        <div class="kf-container kh-home-cta-inner kh-home-cta-inner--portrait">
            <div class="kh-home-cta-copy">
                <h2>@Lang.T("yd2.cta.heading")</h2>
                <a href="/kontakt" class="oo2-cta-link">@Lang.T("yd2.cta.link")</a>
            </div>
            <div class="kh-home-cta-portrait">
                <img src="/Pictures/Gio.jpeg" alt="Giorgio Kevin Beshara" />
            </div>
        </div>
    </section>
</main>

<SiteFooter />

@code {
    private static readonly ServiceCard[] Services =
    [
        new("yd2.service.1.title", "yd2.service.1.text", "websites", ["Hjemmesider", "Responsive", "Brugervenligt", "UI/UX", "SEO"]),
        new("yd2.service.2.title", "yd2.service.2.text", "redesign", ["Redesign", "Figma", "UI/UX", "Brugerrejser", "Performance"]),
        new("yd2.service.3.title", "yd2.service.3.text", "ecommerce", ["Webshop", "Shopify", "WordPress", "Betaling", "Konvertering"]),
        new("yd2.service.6.title", "yd2.service.6.text", "identity", ["Visuel identitet", "Designsystem", "Typografi", "Figma", "Branding"]),
        new("yd2.service.8.title", "yd2.service.8.text", "strategy", ["Strategi", "UX research", "Brugerrejser", "Informationsarkitektur", "Prototyper"]),
    ];

    private sealed record ServiceCard(string TitleKey, string DescriptionKey, string Style, string[] Tags);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await JS.InvokeVoidAsync("initAnimations");
    }
}
