@page "/ydelser"
@inherits LocalizedComponentBase
@inject IJSRuntime JS

<PageTitle>Ydelser – KrydsFelt</PageTitle>

<SiteHeader CurrentPage="services" ContactHref="/kontakt" />

<main class="services-onepage">
    <section class="services-onepage-hero">
        <div class="kf-container">
            <h1>@Lang.T("yd.onepage.hero")</h1>
        </div>
    </section>

    <nav class="services-onepage-index" aria-label="@Lang.T("yd2.services.label")">
        <div class="kf-container">
            <a href="#webudvikling"><span>01</span>@Lang.T("yd2.card.webudvikling.title")</a>
            <a href="#branding-design"><span>02</span>@Lang.T("yd2.card.branding.title")</a>
            <a href="#custom-projekt"><span>03</span>@Lang.T("yd2.card.custom.title")</a>
        </div>
    </nav>

    @foreach (var service in Services)
    {
        <section id="@service.Id" class="services-onepage-product services-onepage-product-@service.Number">
            <div class="kf-container services-onepage-product-grid">
                <div class="services-onepage-product-copy reveal">
                    <span class="services-onepage-number">@service.Number / 03</span>
                    <h2>@Lang.T(service.TitleKey)</h2>
                    <p class="services-onepage-summary">@Lang.T(service.SummaryKey)</p>
                    <div class="services-onepage-specs">
                        <span>@Lang.T("yd.onepage.includes")</span>
                        <ul>
                            @foreach (var itemKey in service.ItemKeys)
                            {
                                <li>@Lang.T(itemKey)</li>
                            }
                        </ul>
                    </div>
                </div>
                <div class="services-onepage-visual reveal" data-delay="120" aria-hidden="true">
                    <span class="services-onepage-crosshair"></span>
                    <strong>@service.Number</strong>
                    <small>KRYDSFELT / DIGITAL SYSTEM</small>
                </div>
            </div>
        </section>
    }

</main>

<!-- BOTTOM CTA -->
<section class="kh-home-cta">
    <div class="kf-container kh-home-cta-inner">
        <span class="oo2-section-label">@Lang.T("yd2.cta.label")</span>
        <h2>@Lang.T("yd2.cta.heading")</h2>
        <p>@Lang.T("yd2.cta.desc")</p>
        <a href="/kontakt" class="oo2-cta-link">@Lang.T("yd2.cta.link")</a>
    </div>
</section>

<SiteFooter />

@code {
    private static readonly ServiceSection[] Services =
    [
        new("webudvikling", "01", "yd2.card.webudvikling.title", "yd.onepage.web.summary", ["yd.onepage.web.i1", "yd.onepage.web.i2", "yd.onepage.web.i3", "yd.onepage.web.i4"]),
        new("branding-design", "02", "yd2.card.branding.title", "yd.onepage.brand.summary", ["yd.onepage.brand.i1", "yd.onepage.brand.i2", "yd.onepage.brand.i3", "yd.onepage.brand.i4"]),
        new("custom-projekt", "03", "yd2.card.custom.title", "yd.onepage.custom.summary", ["yd.onepage.custom.i1", "yd.onepage.custom.i2", "yd.onepage.custom.i3", "yd.onepage.custom.i4"])
    ];

    private sealed record ServiceSection(string Id, string Number, string TitleKey, string SummaryKey, string[] ItemKeys);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("initAnimations");
        }
    }
}
