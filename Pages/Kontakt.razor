@page "/kontakt"
@inherits LocalizedComponentBase

<SeoHead Title="Kontakt Krydsfelt — Lad os tale om jeres hjemmeside"
         Description="Kontakt Krydsfelt om webdesign, en ny hjemmeside, branding eller en specialbygget digital løsning. Vi svarer personligt og uforpligtende."
         Path="/kontakt" />

<SiteHeader CurrentPage="contact" ContactHref="/kontakt" />

<main class="contact-minimal">
    <section class="contact-minimal-panel">
        <div class="kf-container contact-minimal-content">
            <h1>@Lang.T("bk.minimal.heading")</h1>
            <p>@Lang.T("bk.minimal.invite")</p>
            <a href="mailto:krydsfelt.info@gmail.com" class="contact-minimal-mail">
                <span>krydsfelt.info@gmail.com</span>
                <span aria-hidden="true">↗</span>
            </a>
        </div>
    </section>
</main>

<SiteFooter />
