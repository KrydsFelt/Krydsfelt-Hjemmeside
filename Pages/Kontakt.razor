@page "/kontakt"
@inherits LocalizedComponentBase

<SeoHead Title="Krydsfelt - Kontakt os"
         Description="Kontakt Krydsfelt om webdesign, en ny hjemmeside, branding eller en specialbygget digital løsning."
         Path="/kontakt" />
<SiteHeader CurrentPage="contact" ContactHref="/kontakt" />

<main class="kf-contact-page">
    <section class="kf-contact-impact">
        <div class="kf-page-width">
            <div class="kf-contact-impact-title" role="heading" aria-level="1">
                <span>@Lang.T("contact.page.headlineFirst")</span>
                <span>@Lang.T("contact.page.headlineSecondPrefix") <em>@Lang.T("contact.page.headlineSecondAccent")</em></span>
            </div>
            <a class="kf-contact-email-link" href="mailto:krydsfelt.info@gmail.com">krydsfelt.info@gmail.com</a>
        </div>
    </section>
</main>
