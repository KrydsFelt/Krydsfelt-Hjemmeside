@page "/kontakt"
@inherits LocalizedComponentBase

<SeoHead Title="Krydsfelt - Kontakt os"
         Description="Kontakt Krydsfelt om webdesign, en ny hjemmeside, branding eller en specialbygget digital løsning. Vi svarer personligt og uforpligtende."
         Path="/kontakt" />

<SiteHeader CurrentPage="contact" ContactHref="/kontakt" />

<main class="contact-editorial">
    <section class="contact-editorial-section">
        <div class="contact-editorial-cta">
            <div class="contact-editorial-title">Skal vi starte et projekt?</div>
            <p>Fortæl os lidt om det, I arbejder på, og hvad I gerne vil opnå. Uanset om I har en færdig plan eller blot er ved at undersøge mulighederne, tager vi gerne en uforpligtende snak.</p>
            <a class="yd-onepage-hero-link contact-editorial-mail" href="mailto:krydsfelt.info@gmail.com">
                <span class="yd-onepage-hero-link-label" aria-hidden="true">
                    <span>krydsfelt.info@gmail.com</span>
                    <span>krydsfelt.info@gmail.com</span>
                </span>
                <span class="visually-hidden">krydsfelt.info@gmail.com</span>
            </a>
        </div>
    </section>
</main>
