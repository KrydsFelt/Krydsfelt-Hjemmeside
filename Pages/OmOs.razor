@page "/om-os"
@inherits LocalizedComponentBase
@inject IJSRuntime JS

<SeoHead Title="Om Krydsfelt — Dansk webbureau"
         Description="Mød holdet bag Krydsfelt. Vi samler strategi, webdesign og udvikling i et tæt samarbejde med virksomheder i Aarhus, Aalborg og resten af Danmark."
         Path="/om-os" />

<SiteHeader CurrentPage="about" ContactHref="/kontakt" />

<main class="about-editorial">
    <section class="about-editorial-development">
        <div class="kf-container">
            <div class="about-editorial-development-grid">
                <div class="about-editorial-development-copy reveal" data-delay="100">
                    <h2>@Lang.T("about.development.headingPrefix") <span class="about-editorial-accent">@Lang.T("about.development.headingAccent")</span> @Lang.T("about.development.headingSuffix")</h2>
                    <p>@Lang.T("about.development.p1a") <span class="about-editorial-value-word">@Lang.T("about.value3.title")</span> @Lang.T("about.development.p1b") <span class="about-editorial-value-word">@Lang.T("about.value1.title")</span>@Lang.T("about.development.p1c")</p>
                    <p>@Lang.T("about.development.p2a") <span class="about-editorial-value-word">@Lang.T("about.value4.title")</span>@Lang.T("about.development.p2b") <span class="about-editorial-value-word">@Lang.T("about.value5.title")</span> @Lang.T("about.development.p2c") <span class="about-editorial-value-word">@Lang.T("about.value2.title")</span>@Lang.T("about.development.p2d")</p>
                    <p>@Lang.T("about.development.p3a") <span class="about-editorial-value-word">@Lang.T("about.value6.title")</span> @Lang.T("about.development.p3b") <span class="about-editorial-value-word">@Lang.T("about.value7.title")</span>@Lang.T("about.development.p3c")</p>
                </div>
                <img class="about-editorial-development-image reveal" src="Pictures/krydsfelt-hero-monochrome.jpg" alt="@Lang.T("about.development.imageAlt")" />
            </div>
        </div>
    </section>

    <section>
        <div class="kf-container">
            <div class="about-hero-content">
                <span class="about-hero-eyebrow">@Lang.T("about.intro.eyebrow")</span>
                <h1 class="about-connection-title">
                    <span>@Lang.T("about.intro.line1")</span>
                    <span>@Lang.T("about.intro.line2")</span>
                    <span><em>@Lang.T("about.intro.accent")</em></span>
                </h1>
                <p class="about-hero-support">@Lang.T("about.intro.support")</p>
            </div>
            <div class="about-principles-panel">
                <header class="about-principles-head reveal">
                    <h2>@Lang.T("about.principles.heading1") <em>@Lang.T("about.principles.heading2")</em></h2>
                </header>
                <div class="about-principles-grid">
                    <article class="about-principle-card reveal">
                        <div class="about-principle-icon" aria-hidden="true"><svg viewBox="0 0 64 64"><circle cx="32" cy="32" r="22"/><circle cx="32" cy="32" r="9"/><path d="M32 4v9M60 32h-9M32 60v-9M4 32h9"/></svg></div>
                        <div><h3>@Lang.T("about.principles.clarity.title")</h3><p>@Lang.T("about.principles.clarity.text")</p></div>
                    </article>
                    <article class="about-principle-card reveal" data-delay="100">
                        <div class="about-principle-icon" aria-hidden="true"><svg viewBox="0 0 64 64"><path d="M25 39l-5 5a10 10 0 0 1-14-14l10-10a10 10 0 0 1 14 0l3 3M39 25l5-5a10 10 0 0 1 14 14L48 44a10 10 0 0 1-14 0l-3-3M22 42l20-20"/></svg></div>
                        <div><h3>@Lang.T("about.principles.close.title")</h3><p>@Lang.T("about.principles.close.text")</p></div>
                    </article>
                    <article class="about-principle-card reveal" data-delay="200">
                        <div class="about-principle-icon" aria-hidden="true"><svg viewBox="0 0 64 64"><path d="M32 6l22 10v15c0 14-9 23-22 27C19 54 10 45 10 31V16L32 6Z"/><path d="m21 32 7 7 15-16"/></svg></div>
                        <div><h3>@Lang.T("about.principles.durable.title")</h3><p>@Lang.T("about.principles.durable.text")</p></div>
                    </article>
                </div>
            </div>

        </div>

        <div class="kh-home-cta-inner about-inline-cta reveal">
                <h2>@Lang.T("about.cta.heading")</h2>
                <p>@Lang.T("about.cta.text")</p>
                <a href="/kontakt" class="oo2-cta-link">@Lang.T("about.cta.link")</a>
        </div>
    </section>

    <section class="about-editorial-team">
        <div class="kf-container">
            <span class="oo2-section-label">@Lang.T("about.team.label")</span>
            <div class="about-editorial-team-grid">
                <article class="about-editorial-person reveal">
                    <img src="Pictures/Tony.jpeg" alt="Tony Truong" />
                    <div class="about-editorial-person-copy"><span>Founder &amp; CTO</span><h3>Tony Truong</h3></div>
                </article>
                <article class="about-editorial-person reveal" data-delay="100">
                    <img src="Pictures/Gio.jpeg" alt="Giorgio Kevin Beshara" />
                    <div class="about-editorial-person-copy"><span>Co-Founder &amp; Developer</span><h3>Giorgio Kevin Beshara</h3></div>
                </article>
                <article class="about-editorial-person reveal" data-delay="200">
                    <img src="Pictures/Minh.jpeg" alt="Minh Quan Dinh" />
                    <div class="about-editorial-person-copy"><span>Co-Founder &amp; Developer</span><h3>Minh Quan Dinh</h3></div>
                </article>
            </div>
        </div>
    </section>

</main>

<SiteFooter />

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("initAnimations");
        }
    }
}
