@page "/om-os"
@inherits LocalizedComponentBase
@inject IJSRuntime JS

<SeoHead Title="Krydsfelt - Om os"
         Description="Mød Krydsfelt, et digitalt team der samler design, udvikling og forretning i gennemtænkte løsninger."
         Path="/om-os" />
<SiteHeader CurrentPage="about" ContactHref="/kontakt" />

<main class="kf-about-page">
    <section class="kf-about-opening">
        <div class="kf-container vita-home-hero-inner kf-about-opening-content">
            <div class="kf-about-opening-headline" role="heading" aria-level="1">
                <span>@Lang.T("about.page.headlinePrefix")</span> <em>@Lang.T("about.page.headlineAccent")</em>
            </div>
            <div class="kf-about-opening-story">
                <p class="kf-about-opening-detail">@Lang.T("about.page.introDetail")</p>
                <a class="kf-about-opening-link" href="#kf-about-team-grid">Se team</a>
            </div>
            <img class="kf-about-opening-image" src="/Pictures/billede-1.jpg" alt="Minh arbejder ved sin computer" />
        </div>
    </section>

    <section class="kf-about-values kf-about-values-timeline" aria-labelledby="kf-about-values-title">
        <div class="kf-page-width">
            <h2 id="kf-about-values-title">@Lang.T("about.page.valuesHeading")</h2>
            <div class="kf-about-values-list">
                @for (var i = 0; i < Values.Length; i++)
                {
                    var value = Values[i];
                    <article class="kf-about-value-row @(i % 2 == 0 ? "is-left reveal-left" : "is-right reveal-right")" data-delay="@(i * 90)">
                        <div class="kf-about-value-copy">
                            <h3><em>@Lang.T(value.Title)</em></h3>
                            <p>@Lang.T(value.Description)</p>
                        </div>
                    </article>
                }
            </div>
        </div>
    </section>

    <section id="kf-about-team" class="kf-about-team" aria-labelledby="kf-about-team-title">
        <div class="kf-page-width">
            <div class="kf-about-team-heading">
                <h2 id="kf-about-team-title"><em>@Lang.T("about.team.heading")</em></h2>
            </div>
            <div id="kf-about-team-grid" class="kf-about-team-grid">
                @foreach (var person in Team)
                {
                    <article class="kf-about-person">
                        <div class="kf-about-person-image"><img src="@person.Image" alt="@person.Name" /></div>
                        <h3>@person.Name</h3>
                        <p>@Lang.T(person.Description)</p>
                    </article>
                }
            </div>
        </div>
    </section>

    <section class="kh-home-cta">
        <div class="kf-container kh-home-cta-inner kh-home-cta-inner--portrait">
            <div class="kh-home-cta-copy">
                <h2>@Lang.T("home.cta.heading")</h2>
                <a href="/kontakt" class="oo2-cta-link">@Lang.T("home.cta.link")</a>
            </div>
            <div class="kh-home-cta-portrait">
                <img src="/Pictures/Gio.jpeg" alt="Giorgio Kevin Beshara" />
            </div>
        </div>
    </section>
</main>

<SiteFooter />

@code {
    private static readonly (string Title, string Description)[] Values =
    [
        ("about.value.clarity.title", "about.value.clarity.text"),
        ("about.value.precision.title", "about.value.precision.text"),
        ("about.value.purpose.title", "about.value.purpose.text"),
        ("about.value.consistency.title", "about.value.consistency.text"),
        ("about.value.performance.title", "about.value.performance.text")
    ];

    private static readonly (string Name, string Image, string Description)[] Team =
    [
        ("Tony", "/Pictures/Tony.jpeg", "about.team.tony"),
        ("Giorgio", "/Pictures/Gio.jpeg", "about.team.gio"),
        ("Minh", "/Pictures/Minh.jpeg", "about.team.minh")
    ];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await JS.InvokeVoidAsync("initAnimations");
    }
}
