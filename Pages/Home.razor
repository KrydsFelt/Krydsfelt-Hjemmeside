@page "/"
@inherits LocalizedComponentBase
@inject IJSRuntime JS

<SeoHead Title="Krydsfelt - Webbureau i Aarhus & Aalborg"
         Description="Krydsfelt er et dansk webbureau i Aarhus og Aalborg. Vi skaber skræddersyede hjemmesider, webdesign, branding og digitale løsninger til virksomheder."
         Path="/" />

<SiteHeader CurrentPage="home" ContactHref="/kontakt" />

<section class="kf-box-hero kf-container" aria-labelledby="home-hero-title">
    <div class="kf-hero-ripples" aria-hidden="true"></div>
    <div class="kf-box-hero-copy">
        <h3 id="home-hero-title">
            <span>@Lang.T("home.boxHero.title")</span>
            <span>@Lang.T("home.boxHero.titleEnd")</span>
        </h3>
        <p>@Lang.T("home.boxHero.description")</p>
    </div>
</section>

<section class="kh-home-profile">
    <div class="kf-container kh-home-profile-grid">
        <div class="kh-home-profile-copy reveal">
            <h2>@Lang.T("home.profile.heading")</h2>

            <div class="kh-home-profile-media kh-home-profile-media-mobile reveal">
                <img src="Pictures/Tony.jpeg" alt="Tony Xtruong" />
            </div>

            <p>@Lang.T("home.profile.p1")</p>
            <p>@Lang.T("home.profile.p2")</p>
            <p>@Lang.T("home.profile.p3")</p>
            <a href="/om-os" class="kh-home-inline-link">@Lang.T("home.profile.readMore")</a>

            <div class="kh-home-socials">
                <a href="#" aria-label="Instagram" class="kh-home-social-link">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                        <circle cx="12" cy="12" r="4"></circle>
                        <circle cx="17.5" cy="6.5" r="1"></circle>
                    </svg>
                </a>
                <a href="mailto:krydsfelt.info@gmail.com" aria-label="Email" class="kh-home-social-link">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                        <path d="M3 7l9 6 9-6"></path>
                    </svg>
                </a>
            </div>
        </div>

        <div class="kh-home-profile-media reveal" data-delay="140">
            <img src="Pictures/Tony.jpeg" alt="Tony Xtruong" />
        </div>
    </div>
</section>

<section class="kf-services-showcase" aria-labelledby="services-heading">
    <div class="kf-container kf-services-layout">
        <h2 id="services-heading" class="kf-services-heading">@Lang.T("home.services.lead") <span>@Lang.T("home.services.boost")</span> @Lang.T("home.services.ending")</h2>
        <div class="kf-services-showcase-content">
            <p class="kf-services-summary">@Lang.T("home.services.summary")</p>
            <div class="kf-services-grid">
                <a class="kf-service-tile" href="/ydelser">
                    <h3>@Lang.T("home.service1.title")</h3>
                    <div class="kf-service-tile-visual" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3.5" y="5" width="17" height="14" rx="2.5"></rect>
                        <path d="M3.5 9.5h17"></path>
                        <path d="M8 15h3"></path>
                        <path d="M13.5 15h2.5"></path>
                    </svg></div>
                    <p>@Lang.T("home.service1.desc")</p>
                    <span class="kf-service-tile-link">@Lang.T("home.services.readMore") <span aria-hidden="true">→</span></span>
                </a>
                <a class="kf-service-tile" href="/ydelser">
                    <h3>@Lang.T("home.service2.title")</h3>
                    <div class="kf-service-tile-visual" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M8 5.5h8"></path>
                        <path d="M8 18.5h8"></path>
                        <rect x="5" y="3.5" width="14" height="17" rx="3"></rect>
                        <path d="M10 8.5h4"></path>
                        <path d="M9 13h6"></path>
                    </svg></div>
                    <p>@Lang.T("home.service2.desc")</p>
                    <span class="kf-service-tile-link">@Lang.T("home.services.readMore") <span aria-hidden="true">→</span></span>
                </a>
                <a class="kf-service-tile" href="/ydelser">
                    <h3>@Lang.T("home.service3.title")</h3>
                    <div class="kf-service-tile-visual" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m12 3.5 1.75 3.7 4.05.56-2.95 2.88.72 4.08L12 12.78l-3.57 1.94.72-4.08-2.95-2.88 4.05-.56L12 3.5Z"></path>
                        <path d="M16.5 15.5 18 17"></path>
                        <path d="M6 17.5h5"></path>
                    </svg></div>
                    <p>@Lang.T("home.service3.desc")</p>
                    <span class="kf-service-tile-link">@Lang.T("home.services.readMore") <span aria-hidden="true">→</span></span>
                </a>
                <a class="kf-service-tile" href="/ydelser">
                    <h3>@Lang.T("home.service4.title")</h3>
                    <div class="kf-service-tile-visual" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3.5" y="5" width="7" height="7" rx="1.75"></rect>
                        <rect x="13.5" y="5" width="7" height="7" rx="1.75"></rect>
                        <rect x="8.5" y="14" width="7" height="7" rx="1.75"></rect>
                        <path d="M10.5 8.5h3"></path>
                        <path d="M15.5 8.5h-2"></path>
                        <path d="M12 12v2"></path>
                    </svg></div>
                    <p>@Lang.T("home.service4.desc")</p>
                    <span class="kf-service-tile-link">@Lang.T("home.services.readMore") <span aria-hidden="true">→</span></span>
                </a>
            </div>
            <a href="/ydelser" class="kf-services-all">@Lang.T("home.services.seeAll")</a>
        </div>
    </div>
</section>

<section class="kh-home-cta">
    <div class="kf-container kh-home-cta-inner">
        <h2>@Lang.T("home.cta.heading")</h2>
        <a href="/kontakt" class="oo2-cta-link">@Lang.T("home.cta.link")</a>
    </div>
</section>

<SiteFooter />

@code {
    private bool _reanimationNeeded;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Lang.OnLanguageChanged += OnLangChanged;
    }

    private void OnLangChanged() => _reanimationNeeded = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender || _reanimationNeeded)
        {
            _reanimationNeeded = false;
            await JS.InvokeVoidAsync("initAnimations");
        }
    }

    public new void Dispose()
    {
        Lang.OnLanguageChanged -= OnLangChanged;
        base.Dispose();
    }
}
